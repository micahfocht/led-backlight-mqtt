[Unit]
Description=LED Backlight MQTT Controller
Documentation=https://github.com/your-org/led-backlight-mqtt
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=led-backlight
Group=led-backlight

# Path to the virtual environment Python interpreter.
# Adjust VENV_PYTHON if the venv is in a different location.
Environment=VENV_PYTHON=/home/micahfocht/led-backlight-mqtt/.venv/bin/python3
ExecStart=/home/micahfocht/led-backlight-mqtt/.venv/bin/python3 -m led_backlight --config /etc/led-backlight/config.yaml

# Restart on failure with a short delay to avoid hammering the broker
Restart=on-failure
RestartSec=5s

# Give capture devices time to be available after boot
ExecStartPre=/bin/sleep 2

# Environment — alternative to embedding credentials in config.yaml
# EnvironmentFile=/etc/led-backlight/env

# Logging goes to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=led-backlight

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
# ProtectHome must be off because the venv lives in the home directory.
# Tighten by moving the venv to /opt if desired.
ProtectHome=false
PrivateTmp=true
# Access to V4L2 devices is granted via the 'video' group (SupplementaryGroups=video).
# DeviceAllow is intentionally omitted: systemd's path-glob matching for
# DeviceAllow does not work reliably with /dev/video* on all kernels.
SupplementaryGroups=video

[Install]
WantedBy=multi-user.target
